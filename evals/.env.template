# Smelt evals environment — copy to .env and fill in real values.
# Loaded by conftest.py via smelt.load_env(); shell env always wins over .env.
# .env is gitignored; this template is committed.
#
# smelt v0.5.0 role quartet: each role resolves PROVIDER / BASE_URL /
# API_KEY / MODEL from SMELT_<ROLE>_*; unset role keys fall back to the
# shared keys below. Only the shared API key is strictly required.

# ---- Shared fallback (required: API key) ----
SMELT_API_KEY=
SMELT_BASE_URL=https://api.deepseek.com
# SMELT_LLM_PROVIDER=openai

# ---- Agent under test (behavior cases, auto-binding, agent evaluations) ----
# Also the model behind subagent()/router_agent() in the agent test suite.
SMELT_AGENT_MODEL=deepseek-v4-flash
# SMELT_AGENT_PROVIDER=openai
# SMELT_AGENT_BASE_URL=https://api.deepseek.com
# SMELT_AGENT_API_KEY=

# ---- Judge (llm_judge / writing review) ----
SMELT_JUDGE_MODEL=deepseek-v4-flash
# SMELT_JUDGE_PROVIDER=openai
# SMELT_JUDGE_BASE_URL=https://api.deepseek.com
# SMELT_JUDGE_API_KEY=

# ---- Doctor (smelt doctor: mutation check + judge canary) ----
# Prefer a different model family than the agent under test
# to avoid shared blind spots.
# SMELT_DOCTOR_PROVIDER=openai
# SMELT_DOCTOR_BASE_URL=https://api.deepseek.com
# SMELT_DOCTOR_API_KEY=
# SMELT_DOCTOR_MODEL=deepseek-v4-flash

# ---- Challenger (evaluate adversarial probes) ----
# SMELT_CHALLENGER_PROVIDER=openai
# SMELT_CHALLENGER_BASE_URL=https://api.deepseek.com
# SMELT_CHALLENGER_API_KEY=
# SMELT_CHALLENGER_MODEL=deepseek-v4-flash
